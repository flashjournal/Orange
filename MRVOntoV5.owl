<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
    xmlns="http://example.org/mrv#"
    xml:base="http://example.org/mrv"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:prov="http://www.w3.org/ns/prov#">

    <!-- ===================================================== -->
    <!-- ONTOLOGY                                               -->
    <!-- ===================================================== -->

    <owl:Ontology rdf:about="http://example.org/mrv">

        <rdfs:label>MRV Core Ontology</rdfs:label>

        <rdfs:comment>
            Core class hierarchy for Carbon MRV Ontology
        </rdfs:comment>

    </owl:Ontology>

    <!-- ===================================================== -->
    <!-- ABSTRACT SUPERCLASSES                                 -->
    <!-- ===================================================== -->

    <owl:Class rdf:about="#Entity"/>

    <owl:Class rdf:about="#PhysicalEntity">
        <rdfs:subClassOf rdf:resource="#Entity"/>
    </owl:Class>

    <owl:Class rdf:about="#InformationEntity">
        <rdfs:subClassOf rdf:resource="#Entity"/>
    </owl:Class>

    <owl:Class rdf:about="#CarbonAsset">
        <rdfs:subClassOf rdf:resource="#Entity"/>
    </owl:Class>

    <!-- ===================================================== -->
    <!-- AGENTS                                                 -->
    <!-- ===================================================== -->

    <owl:Class rdf:about="#Agent">

        <rdfs:subClassOf rdf:resource="#PhysicalEntity"/>

        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>

    </owl:Class>

    <owl:Class rdf:about="#Organization">
        <rdfs:subClassOf rdf:resource="#Agent"/>
    </owl:Class>

    <owl:Class rdf:about="#Business">
        <rdfs:subClassOf rdf:resource="#Organization"/>
    </owl:Class>

    <owl:Class rdf:about="#Government">
        <rdfs:subClassOf rdf:resource="#Organization"/>
    </owl:Class>

    <owl:Class rdf:about="#Institution">
        <rdfs:subClassOf rdf:resource="#Organization"/>
    </owl:Class>

    <owl:Class rdf:about="#NGO">
        <rdfs:subClassOf rdf:resource="#Organization"/>
    </owl:Class>

    <owl:Class rdf:about="#Reviewer">
        <rdfs:subClassOf rdf:resource="#Agent"/>
    </owl:Class>

    <owl:Class rdf:about="#Validator">
        <rdfs:subClassOf rdf:resource="#Agent"/>
    </owl:Class>

    <owl:Class rdf:about="#Verifier">
        <rdfs:subClassOf rdf:resource="#Agent"/>
    </owl:Class>

    <owl:Class rdf:about="#Publisher">
        <rdfs:subClassOf rdf:resource="#Agent"/>
    </owl:Class>

    <owl:Class rdf:about="#Proponent">
        <rdfs:subClassOf rdf:resource="#Agent"/>
    </owl:Class>

    <!-- ===================================================== -->
    <!-- PHYSICAL ENTITIES                                     -->
    <!-- ===================================================== -->

    <owl:Class rdf:about="#Location">
        <rdfs:subClassOf rdf:resource="#PhysicalEntity"/>
    </owl:Class>

    <owl:Class rdf:about="#Registry">
        <rdfs:subClassOf rdf:resource="#PhysicalEntity"/>
    </owl:Class>

    <!-- ===================================================== -->
    <!-- INFORMATION ENTITIES                                  -->
    <!-- ===================================================== -->

    <owl:Class rdf:about="#Project">
        <rdfs:subClassOf rdf:resource="#Entity"/>
    </owl:Class>

    <owl:Class rdf:about="#Document">
        <rdfs:subClassOf rdf:resource="#InformationEntity"/>
    </owl:Class>

    <owl:Class rdf:about="#GeneralDocument">
        <rdfs:subClassOf rdf:resource="#Document"/>
    </owl:Class>

    <owl:Class rdf:about="#TechnicalDocument">
        <rdfs:subClassOf rdf:resource="#Document"/>
    </owl:Class>

    <owl:Class rdf:about="#DRAM">
        <rdfs:subClassOf rdf:resource="#TechnicalDocument"/>
    </owl:Class>

    <owl:Class rdf:about="#DRAMFinal">
        <rdfs:subClassOf rdf:resource="#TechnicalDocument"/>
    </owl:Class>

    <owl:Class rdf:about="#LCAM">
        <rdfs:subClassOf rdf:resource="#TechnicalDocument"/>
    </owl:Class>

    <owl:Class rdf:about="#ValidationReport">
        <rdfs:subClassOf rdf:resource="#TechnicalDocument"/>
    </owl:Class>

    <owl:Class rdf:about="#VerificationReport">
        <rdfs:subClassOf rdf:resource="#TechnicalDocument"/>
    </owl:Class>

    <owl:Class rdf:about="#EmissionWorksheet">
        <rdfs:subClassOf rdf:resource="#TechnicalDocument"/>
    </owl:Class>

    <owl:Class rdf:about="#SupportingDocument">
        <rdfs:subClassOf rdf:resource="#TechnicalDocument"/>
    </owl:Class>

    <owl:Class rdf:about="#Certificate">
        <rdfs:subClassOf rdf:resource="#InformationEntity"/>
    </owl:Class>

    <owl:Class rdf:about="#SPECertificate">
        <rdfs:subClassOf rdf:resource="#Certificate"/>
    </owl:Class>

    <owl:Class rdf:about="#RegistryNumber">
        <rdfs:subClassOf rdf:resource="#InformationEntity"/>
    </owl:Class>

    <owl:Class rdf:about="#Methodology">
        <rdfs:subClassOf rdf:resource="#InformationEntity"/>
    </owl:Class>

    <!-- ===================================================== -->
    <!-- CARBON ASSETS                                         -->
    <!-- ===================================================== -->

    <owl:Class rdf:about="#CER">
        <rdfs:subClassOf rdf:resource="#CarbonAsset"/>
    </owl:Class>

    <!-- ===================================================== -->
    <!-- MRV WORKFLOW                                           -->
    <!-- ===================================================== -->

    <owl:Class rdf:about="#MRVActivity">

        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>

    </owl:Class>

    <owl:Class rdf:about="#Proposal">
        <rdfs:subClassOf rdf:resource="#MRVActivity"/>
    </owl:Class>

    <owl:Class rdf:about="#Validation">
        <rdfs:subClassOf rdf:resource="#MRVActivity"/>
    </owl:Class>

    <owl:Class rdf:about="#Verification">
        <rdfs:subClassOf rdf:resource="#MRVActivity"/>
    </owl:Class>

    <owl:Class rdf:about="#Publication">
        <rdfs:subClassOf rdf:resource="#MRVActivity"/>
    </owl:Class>

    <!-- ===================================================== -->
    <!-- DISJOINT AXIOMS                                       -->
    <!-- ===================================================== -->

    <owl:AllDisjointClasses>

        <owl:members rdf:parseType="Collection">

            <rdf:Description rdf:about="#Proposal"/>
            <rdf:Description rdf:about="#Validation"/>
            <rdf:Description rdf:about="#Verification"/>
            <rdf:Description rdf:about="#Publication"/>

        </owl:members>

    </owl:AllDisjointClasses>

    <owl:AllDisjointClasses>

        <owl:members rdf:parseType="Collection">

            <rdf:Description rdf:about="#GeneralDocument"/>
            <rdf:Description rdf:about="#TechnicalDocument"/>

        </owl:members>

    </owl:AllDisjointClasses>

    <owl:AllDisjointClasses>

        <owl:members rdf:parseType="Collection">

            <rdf:Description rdf:about="#Business"/>
            <rdf:Description rdf:about="#Government"/>
            <rdf:Description rdf:about="#Institution"/>
            <rdf:Description rdf:about="#NGO"/>

        </owl:members>

    </owl:AllDisjointClasses>

    <owl:AllDisjointClasses>

        <owl:members rdf:parseType="Collection">

            <rdf:Description rdf:about="#Reviewer"/>
            <rdf:Description rdf:about="#Validator"/>
            <rdf:Description rdf:about="#Verifier"/>
            <rdf:Description rdf:about="#Publisher"/>
            <rdf:Description rdf:about="#Proponent"/>

        </owl:members>

    </owl:AllDisjointClasses>

    <owl:AllDisjointClasses>

        <owl:members rdf:parseType="Collection">

            <rdf:Description rdf:about="#DRAM"/>
            <rdf:Description rdf:about="#DRAMFinal"/>
            <rdf:Description rdf:about="#LCAM"/>
            <rdf:Description rdf:about="#ValidationReport"/>
            <rdf:Description rdf:about="#VerificationReport"/>
            <rdf:Description rdf:about="#EmissionWorksheet"/>
            <rdf:Description rdf:about="#SupportingDocument"/>

        </owl:members>

    </owl:AllDisjointClasses>

<!-- ===================================================== -->
<!-- Disjoint MRV Workflow Activities -->
<!-- ===================================================== -->

<owl:AllDisjointClasses>

    <owl:members rdf:parseType="Collection">

        <rdf:Description rdf:about="#Proposal"/>

        <rdf:Description rdf:about="#Validation"/>

        <rdf:Description rdf:about="#Verification"/>

        <rdf:Description rdf:about="#Publication"/>

    </owl:members>

</owl:AllDisjointClasses>
  
<!-- ===================================================== -->
<!-- Disjoint Technical Documents -->
<!-- ===================================================== -->

<owl:AllDisjointClasses>

    <owl:members rdf:parseType="Collection">

        <rdf:Description rdf:about="#DRAM"/>

        <rdf:Description rdf:about="#DRAMFinal"/>

        <rdf:Description rdf:about="#LCAM"/>

        <rdf:Description rdf:about="#ValidationReport"/>

        <rdf:Description rdf:about="#VerificationReport"/>

        <rdf:Description rdf:about="#EmissionWorksheet"/>

    </owl:members>

</owl:AllDisjointClasses>

<!-- ===================================================== -->
<!-- Disjoint MRV Roles -->
<!-- ===================================================== -->

<owl:AllDisjointClasses>

    <owl:members rdf:parseType="Collection">

        <rdf:Description rdf:about="#Reviewer"/>

        <rdf:Description rdf:about="#Validator"/>

        <rdf:Description rdf:about="#Verifier"/>

        <rdf:Description rdf:about="#Publisher"/>

    </owl:members>

</owl:AllDisjointClasses>


<owl:AllDisjointClasses>

    <owl:members rdf:parseType="Collection">

        <rdf:Description rdf:about="#Proponent"/>

        <rdf:Description rdf:about="#Reviewer"/>

        <rdf:Description rdf:about="#Validator"/>

        <rdf:Description rdf:about="#Verifier"/>

        <rdf:Description rdf:about="#Publisher"/>

    </owl:members>

</owl:AllDisjointClasses>

<owl:AllDisjointClasses>

    <owl:members rdf:parseType="Collection">

        <rdf:Description rdf:about="#PhysicalEntity"/>

        <rdf:Description rdf:about="#InformationEntity"/>

        <rdf:Description rdf:about="#CarbonAsset"/>

        <rdf:Description rdf:about="#MRVActivity"/>

    </owl:members>

</owl:AllDisjointClasses>


<owl:AllDisjointClasses>

    <owl:members rdf:parseType="Collection">

        <rdf:Description rdf:about="#Business"/>

        <rdf:Description rdf:about="#Government"/>

        <rdf:Description rdf:about="#Institution"/>

        <rdf:Description rdf:about="#NGO"/>

    </owl:members>

</owl:AllDisjointClasses>

<owl:AllDisjointClasses>

    <owl:members rdf:parseType="Collection">

        <rdf:Description rdf:about="#Document"/>

        <rdf:Description rdf:about="#Certificate"/>

        <rdf:Description rdf:about="#Methodology"/>

        <rdf:Description rdf:about="#RegistryNumber"/>

    </owl:members>

</owl:AllDisjointClasses>

<!-- ========================================================= -->
<!-- PROJECT PROPERTIES                                        -->
<!-- ========================================================= -->

<owl:ObjectProperty rdf:about="#implementedBy">
    <rdfs:domain rdf:resource="#Project"/>
    <rdfs:range rdf:resource="#Business"/>
    <owl:inverseOf rdf:resource="#implementsProject"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#implementsProject">
    <rdfs:domain rdf:resource="#Business"/>
    <rdfs:range rdf:resource="#Project"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDocument">
    <rdfs:domain rdf:resource="#Project"/>
    <rdfs:range rdf:resource="#Document"/>
    <owl:inverseOf rdf:resource="#belongsToProject"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#belongsToProject">
    <rdfs:domain rdf:resource="#Document"/>
    <rdfs:range rdf:resource="#Project"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#registeredIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="#Project"/>
    <rdfs:range rdf:resource="#Registry"/>
    <owl:inverseOf rdf:resource="#registersProject"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#registersProject">
    <rdfs:domain rdf:resource="#Registry"/>
    <rdfs:range rdf:resource="#Project"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasLocation">
    <rdfs:domain rdf:resource="#Project"/>
    <rdfs:range rdf:resource="#Location"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#usesMethodology">
    <rdfs:domain rdf:resource="#Project"/>
    <rdfs:range rdf:resource="#Methodology"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasCertificate">
    <rdfs:domain rdf:resource="#Project"/>
    <rdfs:range rdf:resource="#SPECertificate"/>
    <owl:inverseOf rdf:resource="#issuedForProject"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasCER">
    <rdfs:domain rdf:resource="#Project"/>
    <rdfs:range rdf:resource="#CER"/>
</owl:ObjectProperty>

<!-- corrected by gemini -->  

<owl:ObjectProperty rdf:about="#hasRegistryNumber">
    <rdfs:domain rdf:resource="#Project"/>
    <rdfs:range rdf:resource="#RegistryNumber"/>
</owl:ObjectProperty>

<!-- ========================================================= -->
<!-- WORKFLOW                                                  -->
<!-- ========================================================= -->

<owl:ObjectProperty rdf:about="#hasProject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="#MRVActivity"/>
    <rdfs:range rdf:resource="#Project"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#performedBy">
    <rdfs:domain rdf:resource="#MRVActivity"/>
    <rdfs:range rdf:resource="#Agent"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasInputDocument">
    <rdfs:domain rdf:resource="#MRVActivity"/>
    <rdfs:range rdf:resource="#Document"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasOutputDocument">
    <rdfs:domain rdf:resource="#MRVActivity"/>
    <rdfs:range rdf:resource="#Document"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#nextProcess">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:domain rdf:resource="#MRVActivity"/>
    <rdfs:range rdf:resource="#MRVActivity"/>
    <owl:inverseOf rdf:resource="#previousProcess"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#previousProcess">
    <rdfs:domain rdf:resource="#MRVActivity"/>
    <rdfs:range rdf:resource="#MRVActivity"/>
</owl:ObjectProperty>

<!-- ========================================================= -->
<!-- DOCUMENT                                                  -->
<!-- ========================================================= -->

<owl:ObjectProperty rdf:about="#basedOn">
    <rdfs:domain rdf:resource="#Document"/>
    <rdfs:range rdf:resource="#Document"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#preparedBy">
    <rdfs:domain rdf:resource="#Document"/>
    <rdfs:range rdf:resource="#Agent"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#reviewedBy">
    <rdfs:domain rdf:resource="#Document"/>
    <rdfs:range rdf:resource="#Reviewer"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#validatedBy">
    <rdfs:domain rdf:resource="#Document"/>
    <rdfs:range rdf:resource="#Validator"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#verifiedBy">
    <rdfs:domain rdf:resource="#Document"/>
    <rdfs:range rdf:resource="#Verifier"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#publishedBy">
    <rdfs:domain rdf:resource="#Document"/>
    <rdfs:range rdf:resource="#Publisher"/>
</owl:ObjectProperty>

<!-- ========================================================= -->
<!-- CERTIFICATE                                               -->
<!-- ========================================================= -->

<owl:ObjectProperty rdf:about="#issuedForProject">
    <rdfs:domain rdf:resource="#SPECertificate"/>
    <rdfs:range rdf:resource="#Project"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#issuedByRegistry">
    <rdfs:domain rdf:resource="#SPECertificate"/>
    <rdfs:range rdf:resource="#Registry"/>
    <owl:inverseOf rdf:resource="#issuesCertificate"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#issuesCertificate">
    <rdfs:domain rdf:resource="#Registry"/>
    <rdfs:range rdf:resource="#SPECertificate"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#certifiesCER">
    <rdfs:domain rdf:resource="#SPECertificate"/>
    <rdfs:range rdf:resource="#CER"/>
</owl:ObjectProperty>

<!-- ========================================================= -->
<!-- Restriction - Proposal                                    -->
<!-- ========================================================= -->

<owl:Class rdf:about="#Proposal">

    <rdfs:subClassOf rdf:resource="#MRVActivity"/>

    <rdfs:subClassOf>

        <owl:Restriction>

            <owl:onProperty rdf:resource="#hasProject"/>

            <owl:qualifiedCardinality
                rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">

                1

            </owl:qualifiedCardinality>

            <owl:onClass rdf:resource="#Project"/>

        </owl:Restriction>

    </rdfs:subClassOf>

</owl:Class>

<!-- ========================================================= -->
<!-- Restriction - Validation-InputDRAM                        -->
<!-- ========================================================= -->

<owl:Class rdf:about="#Validation">

    <rdfs:subClassOf rdf:resource="#MRVActivity"/>

    <rdfs:subClassOf>

        <owl:Restriction>

            <owl:onProperty rdf:resource="#hasInputDocument"/>

            <owl:someValuesFrom rdf:resource="#DRAM"/>

        </owl:Restriction>

    </rdfs:subClassOf>

</owl:Class>

<!-- ========================================================= -->
<!-- Restriction - Verification Output LCAM                    -->
<!-- ========================================================= -->

<owl:Class rdf:about="#Verification">

    <rdfs:subClassOf rdf:resource="#MRVActivity"/>

    <rdfs:subClassOf>

        <owl:Restriction>

            <owl:onProperty rdf:resource="#hasOutputDocument"/>

            <owl:someValuesFrom rdf:resource="#LCAM"/>

        </owl:Restriction>

    </rdfs:subClassOf>

</owl:Class>

<!-- ========================================================= -->
<!-- Restriction - Publication Output Certificate SPE          -->
<!-- ========================================================= -->

<owl:Class rdf:about="#Publication">

    <rdfs:subClassOf rdf:resource="#MRVActivity"/>

    <rdfs:subClassOf>

        <owl:Restriction>

            <owl:onProperty rdf:resource="#hasOutputDocument"/>

            <owl:someValuesFrom rdf:resource="#SPECertificate"/>

        </owl:Restriction>

    </rdfs:subClassOf>

</owl:Class>

<!-- ========================================================= -->
<!-- Restriction - Project, at least one document          -->
<!-- ========================================================= -->

<owl:Class rdf:about="#Project">

    <rdfs:subClassOf rdf:resource="#Entity"/>

    <rdfs:subClassOf>

        <owl:Restriction>

            <owl:onProperty rdf:resource="#hasDocument"/>

            <owl:minQualifiedCardinality
                rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">

                1

            </owl:minQualifiedCardinality>

            <owl:onClass rdf:resource="#Document"/>

        </owl:Restriction>

    </rdfs:subClassOf>

</owl:Class>

<!-- ========================================================= -->
<!-- Restriction - Project, exactly one registry               -->
<!-- ========================================================= -->

<owl:Class rdf:about="#Project">

    <rdfs:subClassOf>

        <owl:Restriction>

            <owl:onProperty rdf:resource="#registeredIn"/>

            <owl:qualifiedCardinality
                rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">

                1

            </owl:qualifiedCardinality>

            <owl:onClass rdf:resource="#Registry"/>

        </owl:Restriction>

    </rdfs:subClassOf>

</owl:Class>

<!-- ========================================================= -->
<!-- Restriction - OWL restriction             -->
<!-- ========================================================= -->
<owl:Class rdf:about="#Proposal">

    <rdfs:subClassOf rdf:resource="#MRVActivity"/>

    <rdfs:subClassOf>

        <owl:Restriction>
            <owl:onProperty rdf:resource="#performedBy"/>
            <owl:allValuesFrom rdf:resource="#Proponent"/>
        </owl:Restriction>

    </rdfs:subClassOf>

    <rdfs:subClassOf>

        <owl:Restriction>
            <owl:onProperty rdf:resource="#hasInputDocument"/>
            <owl:someValuesFrom rdf:resource="#GeneralDocument"/>
        </owl:Restriction>

    </rdfs:subClassOf>

    <rdfs:subClassOf>

        <owl:Restriction>
            <owl:onProperty rdf:resource="#hasOutputDocument"/>
            <owl:someValuesFrom rdf:resource="#DRAM"/>
        </owl:Restriction>

    </rdfs:subClassOf>

</owl:Class>


<!-- Validation -->

<owl:Class rdf:about="#Validation">

    <rdfs:subClassOf>

        <owl:Restriction>

            <owl:onProperty rdf:resource="#performedBy"/>

            <owl:allValuesFrom rdf:resource="#Validator"/>

        </owl:Restriction>

    </rdfs:subClassOf>

    <rdfs:subClassOf>

        <owl:Restriction>

            <owl:onProperty rdf:resource="#hasInputDocument"/>

            <owl:someValuesFrom rdf:resource="#DRAM"/>

        </owl:Restriction>

    </rdfs:subClassOf>

    <rdfs:subClassOf>

        <owl:Restriction>

            <owl:onProperty rdf:resource="#hasOutputDocument"/>

            <owl:someValuesFrom rdf:resource="#DRAMFinal"/>

        </owl:Restriction>

    </rdfs:subClassOf>

</owl:Class>

<!-- OWL Lineage -->

<owl:ObjectProperty rdf:about="#basedOn">

    <rdfs:domain rdf:resource="#Document"/>

    <rdfs:range rdf:resource="#Document"/>

</owl:ObjectProperty>

<!-- ========================================================= -->
<!-- Restriction - Document Connectivity              -->
<!-- ========================================================= -->
<owl:ObjectProperty rdf:about="#implementedBy">

    <rdfs:domain rdf:resource="#Project"/>

    <rdfs:range rdf:resource="#Business"/>

    <owl:inverseOf rdf:resource="#implementsProject"/>

</owl:ObjectProperty>


<owl:ObjectProperty rdf:about="#implementsProject">

    <rdfs:domain rdf:resource="#Business"/>

    <rdfs:range rdf:resource="#Project"/>

</owl:ObjectProperty>
<!-- ========================================================= -->
<!-- Restriction - Business connectivity                       -->
<!-- ========================================================= -->

<owl:ObjectProperty rdf:about="#implementedBy">

    <rdfs:domain rdf:resource="#Project"/>

    <rdfs:range rdf:resource="#Business"/>

    <owl:inverseOf rdf:resource="#implementsProject"/>

</owl:ObjectProperty>


<owl:ObjectProperty rdf:about="#implementsProject">

    <rdfs:domain rdf:resource="#Business"/>

    <rdfs:range rdf:resource="#Project"/>

</owl:ObjectProperty>


<owl:ObjectProperty rdf:about="#submittedBy">

    <rdfs:domain rdf:resource="#Proposal"/>

    <rdfs:range rdf:resource="#Business"/>

</owl:ObjectProperty>
<!-- ========================================================= -->
<!-- Restriction - Registry Connectivity         -->
<!-- ========================================================= -->
<owl:ObjectProperty rdf:about="#registeredIn">

    <rdfs:domain rdf:resource="#Project"/>

    <rdfs:range rdf:resource="#Registry"/>

</owl:ObjectProperty>


<owl:ObjectProperty rdf:about="#issuesCertificate">

    <rdfs:domain rdf:resource="#Registry"/>

    <rdfs:range rdf:resource="#SPECertificate"/>

</owl:ObjectProperty>
<!-- ========================================================= -->
<!-- Restriction - Certificate Connectivity         -->
<!-- ========================================================= -->
<owl:ObjectProperty rdf:about="#hasCertificate">

    <rdfs:domain rdf:resource="#Project"/>

    <rdfs:range rdf:resource="#SPECertificate"/>

</owl:ObjectProperty>


<owl:ObjectProperty rdf:about="#certifiesCER">

    <rdfs:domain rdf:resource="#SPECertificate"/>

    <rdfs:range rdf:resource="#CER"/>

</owl:ObjectProperty>
<!-- ========================================================= -->
<!-- Restriction - Methodology Connectivity         -->
<!-- ========================================================= -->
<owl:ObjectProperty rdf:about="#usesMethodology">

    <rdfs:domain rdf:resource="#Project"/>

    <rdfs:range rdf:resource="#Methodology"/>

</owl:ObjectProperty>
<!-- ========================================================= -->
<!-- Restriction - Location Connectivity         -->
<!-- ========================================================= -->
<owl:ObjectProperty rdf:about="#hasLocation">

    <rdfs:domain rdf:resource="#Project"/>

    <rdfs:range rdf:resource="#Location"/>

</owl:ObjectProperty>

<!-- ===================================================== -->
<!-- Property Chain: Project -> Certificate -> Registry -->
<!-- ===================================================== -->

<owl:ObjectProperty rdf:about="#registeredIn">

    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>

    <owl:propertyChainAxiom rdf:parseType="Collection">

        <rdf:Description rdf:about="#hasCertificate"/>

        <rdf:Description rdf:about="#issuedByRegistry"/>

    </owl:propertyChainAxiom>

</owl:ObjectProperty>

<!-- ===================================================== -->
<!-- Property Chain: Project -> Certificate -> CER -->
<!-- ===================================================== -->

<owl:ObjectProperty rdf:about="#hasCER">

    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>

    <owl:propertyChainAxiom rdf:parseType="Collection">

        <rdf:Description rdf:about="#hasCertificate"/>

        <rdf:Description rdf:about="#certifiesCER"/>

    </owl:propertyChainAxiom>

</owl:ObjectProperty>


<!-- ===================================================== -->
<!-- Property Chain: Proposal -> Project -> Registry -->
<!-- ===================================================== -->

<owl:ObjectProperty rdf:about="#registeredIn">

    <owl:propertyChainAxiom rdf:parseType="Collection">

        <rdf:Description rdf:about="#hasProject"/>

        <rdf:Description rdf:about="#registeredIn"/>

    </owl:propertyChainAxiom>

</owl:ObjectProperty>


<owl:ObjectProperty rdf:about="#submittedBy">

    <owl:propertyChainAxiom rdf:parseType="Collection">

        <rdf:Description rdf:about="#hasProject"/>

        <rdf:Description rdf:about="#implementedBy"/>

    </owl:propertyChainAxiom>

</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasLocation">

    <owl:propertyChainAxiom rdf:parseType="Collection">

        <rdf:Description rdf:about="#hasProject"/>

        <rdf:Description rdf:about="#hasLocation"/>

