        <rdf:Description rdf:about="#hasProject"/>

        <rdf:Description rdf:about="#hasCER"/>

    </owl:propertyChainAxiom>

</owl:ObjectProperty>

<!-- document lineage -->


<owl:ObjectProperty rdf:about="#belongsToProject">

